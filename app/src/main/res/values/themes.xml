<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FieldStamp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fs_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash (Android 12 style on every API level) shown until the start screen is decided. -->
    <style name="Theme.FieldStamp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fs_background</item>
        <!-- Carries its own teal disc; see splash_icon.xml. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FieldStamp</item>
    </style>
</resources>
